# We're using Alpine's /bin/sh, so disable pipefail suggestion.
# hadolint global ignore=DL4006

# wget from Alpine doesn't support --progress.
# hadolint global ignore=DL3047

FROM dhi.io/alpine-base:3.22-dev AS verifier

ARG GOSECVER
ARG GOSECSHA

RUN mkdir -p /tmp/gosec && \
    wget -O /tmp/gosec.tar.gz https://github.com/securego/gosec/releases/download/v${GOSECVER}/gosec_${GOSECVER}_linux_amd64.tar.gz && \
    echo "$GOSECSHA  /tmp/gosec.tar.gz" | sha256sum -c - && \
    tar -xzvf /tmp/gosec.tar.gz -C /tmp/gosec

# Base image requirements:
#   - Go toolchain (gosec)
FROM dhi.io/golang:1.24.13-alpine3.22

ARG MAINTAINER
LABEL maintainer=$MAINTAINER

COPY --from=verifier /tmp/gosec/gosec /usr/local/bin/gosec
